<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Chatly.Main" parent="Theme.Chatly">
        <item name="android:windowBackground">@color/register_sheet</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/register_text_primary</item>
    </style>

    <style name="TextAppearance.Chatly.Main.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.Chatly.Main.NavLabel.Active">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>


    <style name="Widget.Chatly.Main.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Widget.Chatly.Main.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Chatly.Main.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Chatly.Main.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Chatly.Main.NavIndicator</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemBackground">@drawable/bg_nav_item</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">8dp</item>
    </style>
</resources>