<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Chatly.LockPin.Title" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/register_text_primary</item>
    </style>

    <style name="TextAppearance.Chatly.LockPin.Key" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/register_text_primary</item>
    </style>

    <!-- Base: dùng cho cả phím số lẫn phím icon -->
    <style name="Widget.Chatly.LockPin.Key" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/lock_pin_key_margin</item>
        <item name="android:background">@drawable/bg_lock_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Chatly.LockPin.Key.Digit">
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Chatly.LockPin.Key</item>
    </style>
</resources>