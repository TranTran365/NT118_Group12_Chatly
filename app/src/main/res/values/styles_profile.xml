<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ShapeAppearance.Chatly.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Chatly.Profile.Eyebrow" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Chatly.Profile.Name" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight" tools:targetApi="p">32sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Chatly.Profile.Initials" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/register_blue</item>
    </style>

    <style name="TextAppearance.Chatly.Profile.Sticker" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="TextAppearance.Chatly.Profile.Pill" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/register_text_primary</item>
    </style>

    <style name="Widget.Chatly.Profile" parent="" />

    <style name="Widget.Chatly.Profile.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/register_field_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/register_corner</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Chatly.Profile.Row" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Chatly.Profile.Divider" parent="">
        <item name="android:background">@color/register_divider</item>
    </style>

    <style name="Widget.Chatly.Profile.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="showText">false</item>
    </style>
</resources>