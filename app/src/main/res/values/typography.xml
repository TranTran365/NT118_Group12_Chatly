<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Headline lớn: "Your people. Your kind of chat." -->
    <style name="TextAppearance.Chatly.Display" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Chatly.Title" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Chatly.Label" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Chatly.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_background_muted</item>
    </style>

    <style name="TextAppearance.Chatly.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_background_muted</item>
    </style>

    <style name="TextAppearance.Chatly.Input" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Chatly.Button" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>