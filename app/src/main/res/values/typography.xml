<resources>
    <style name="TextAppearance.Chatly.Title" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/bevietnampro_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/chatly_lime</item>
    </style>
    <style name="TextAppearance.Chatly.Label" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/bevietnampro_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/chatly_white</item>
    </style>
    <style name="TextAppearance.Chatly.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/bevietnampro_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/chatly_white</item>
    </style>
    <style name="TextAppearance.Chatly.Button" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/bevietnampro_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/chatly_blue</item>
    </style>
</resources>