<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Chatly.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/chatly_lime</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_field</item>
        <item name="endIconTint">@color/chatly_blue</item>
    </style>

    <style name="Widget.Chatly.TextInput.White">
        <item name="boxBackgroundColor">@color/chatly_white</item>
    </style>

    <style name="Widget.Chatly.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/chatly_lime</item>
        <item name="cornerRadius">@dimen/corner_field</item>
        <item name="android:textAppearance">@style/TextAppearance.Chatly.Button</item>
    </style>
</resources>