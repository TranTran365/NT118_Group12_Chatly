<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="welcome_corner">14dp</dimen>

    <style name="TextAppearance.Chatly.Welcome.Headline" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:lineHeight">44sp</item>
        <item name="lineHeight">44sp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.Chatly.Welcome.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_background_muted</item>
    </style>

    <style name="TextAppearance.Chatly.Welcome.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/on_background_muted</item>
    </style>

    <style name="TextAppearance.Chatly.Welcome.Tag" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="TextAppearance.Chatly.Welcome.Button" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Chatly.Welcome.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">@dimen/welcome_corner</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Chatly.Welcome.Button</item>
        <item name="iconTint">@color/on_accent</item>
    </style>

    <style name="Widget.Chatly.Welcome.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/welcome_corner</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textAppearance">@style/TextAppearance.Chatly.Welcome.Button</item>
    </style>

    <style name="TextAppearance.Chatly.Welcome.Pill" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>