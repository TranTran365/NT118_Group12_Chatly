<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Chatly.MediaViewer.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Chatly.MediaViewer.Subtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/media_viewer_subtitle</item>
    </style>

    <style name="ShapeAppearance.Chatly.MediaThumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
