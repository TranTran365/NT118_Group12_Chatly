<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/register_sheet"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/register_header_padding_bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/register_back"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_reg_back"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/register_logo_description"
                    android:src="@drawable/ic_chatly_logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Headline" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_subtitle"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Subtitle" />
        </LinearLayout>

        <!-- Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/register_sheet"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="30dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="32dp">

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_label_email"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.Chatly.Register.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_label_to_field"
                app:startIconDrawable="@drawable/ic_reg_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:autofillHints="emailAddress"
                    android:hint="@string/register_hint_email"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    tools:text="alex.morgan@gmail.com" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_field_to_label"
                android:text="@string/register_label_password"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.Chatly.Register.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_label_to_field"
                app:endIconDrawable="@drawable/ic_reg_password_toggle"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_reg_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:autofillHints="password"
                    android:hint="@string/register_hint_password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    tools:text="password1234" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot password -->
            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="@string/login_forgot_password"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel"
                android:textColor="@color/register_blue" />

            <!-- Sign in -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_in"
                style="@style/Widget.Chatly.Register.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/register_button_height"
                android:layout_marginTop="20dp"
                android:gravity="start|center_vertical"
                android:text="@string/login_sign_in"
                android:textAlignment="viewStart"
                app:icon="@drawable/ic_reg_arrow_forward"
                app:iconGravity="end"
                app:iconSize="20dp" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/register_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/register_or_continue_with"
                    android:textAppearance="@style/TextAppearance.Chatly.Register.Muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/register_divider" />
            </LinearLayout>

            <!-- Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google"
                style="@style/Widget.Chatly.Register.Button.Google"
                android:layout_width="match_parent"
                android:layout_height="@dimen/register_button_height"
                android:layout_marginTop="24dp"
                android:text="@string/register_continue_google"
                app:icon="@drawable/ic_reg_google"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="20dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Footer -->
            <TextView
                android:id="@+id/tv_create_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/login_new_here"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Footer" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>