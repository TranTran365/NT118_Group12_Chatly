<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chats_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_attach_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="0.05"
        android:text="@string/attach_label"
        android:textColor="@color/register_text_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/nunito_extrabold"
        android:text="@string/attach_title"
        android:textColor="@color/surface_deep"
        android:textSize="28sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <TextView
            android:id="@+id/opt_gallery"
            style="@style/Widget.Chatly.AttachOption"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:drawableTop="@drawable/ic_attach_gallery"
            android:text="@string/attach_gallery" />

        <TextView
            android:id="@+id/opt_camera"
            style="@style/Widget.Chatly.AttachOption"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:drawableTop="@drawable/ic_attach_camera"
            android:text="@string/attach_camera" />

        <TextView
            android:id="@+id/opt_file"
            style="@style/Widget.Chatly.AttachOption"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:drawableTop="@drawable/ic_attach_file"
            android:text="@string/attach_file" />

        <TextView
            android:id="@+id/opt_location"
            style="@style/Widget.Chatly.AttachOption"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:drawableTop="@drawable/ic_attach_location"
            android:text="@string/attach_location" />

        <TextView
            android:id="@+id/opt_voice"
            style="@style/Widget.Chatly.AttachOption"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:drawableTop="@drawable/ic_attach_voice"
            android:text="@string/attach_voice" />
    </GridLayout>
</LinearLayout>