<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/fl_chat_avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chat_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_chat_initials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAppearance="@style/TextAppearance.Chatly.Chats.Initials" />

        <ImageView
            android:id="@+id/iv_chat_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_chat_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Chatly.Chats.Name"
        app:layout_constraintBottom_toTopOf="@id/tv_chat_preview"
        app:layout_constraintEnd_toStartOf="@id/tv_chat_time"
        app:layout_constraintStart_toEndOf="@id/fl_chat_avatar"
        app:layout_constraintTop_toTopOf="@id/fl_chat_avatar"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_chat_preview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Chatly.Chats.Preview"
        app:layout_constraintBottom_toBottomOf="@id/fl_chat_avatar"
        app:layout_constraintEnd_toStartOf="@id/tv_chat_unread"
        app:layout_constraintStart_toStartOf="@id/tv_chat_name"
        app:layout_constraintTop_toBottomOf="@id/tv_chat_name" />

    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:textAppearance="@style/TextAppearance.Chatly.Chats.Time"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_chat_name"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_chat_unread"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_chat_unread"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textAppearance="@style/TextAppearance.Chatly.Chats.Badge"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fl_chat_avatar"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/register_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_chat_name" />
</androidx.constraintlayout.widget.ConstraintLayout>
