<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/register_sheet"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.profile.PrivacySecurityActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header xanh -->
        <LinearLayout
            android:id="@+id/header_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/register_header_padding_bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/register_back"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_reg_back"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/register_logo_description"
                    android:src="@drawable/ic_chatly_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_title"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_subtitle"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Subtitle" />
        </LinearLayout>

        <!-- Nội dung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_app_security"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <!-- Card: App security -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chatly.Profile.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- App lock -->
                    <LinearLayout
                        android:id="@+id/row_app_lock"
                        style="@style/Widget.Chatly.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_reg_lock"
                            app:tint="@color/register_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_app_lock"
                                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_app_lock_desc"
                                android:textAppearance="@style/TextAppearance.Chatly.Register.Muted" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_app_lock"
                            style="@style/Widget.Chatly.Profile.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.Chatly.Profile.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <!-- Fingerprint -->
                    <LinearLayout
                        android:id="@+id/row_fingerprint"
                        style="@style/Widget.Chatly.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_lock_fingerprint" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_fingerprint"
                                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_fingerprint_desc"
                                android:textAppearance="@style/TextAppearance.Chatly.Register.Muted" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_fingerprint"
                            style="@style/Widget.Chatly.Profile.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.Chatly.Profile.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <!-- Change PIN -->
                    <LinearLayout
                        android:id="@+id/row_change_pin"
                        style="@style/Widget.Chatly.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <!-- ICON TẠM: đổi thành @drawable/ic_priv_key sau khi export từ Figma -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_reg_lock"
                            app:tint="@color/register_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_change_pin"
                                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_change_pin_desc"
                                android:textAppearance="@style/TextAppearance.Chatly.Register.Muted" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_prof_chevron"
                            app:tint="@color/register_icon_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/privacy_section_chat_privacy"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <!-- Card: Chat privacy (chỉ UI, chưa có logic) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chatly.Profile.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:id="@+id/row_locked_chats"
                    style="@style/Widget.Chatly.Profile.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_reg_lock"
                        app:tint="@color/register_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_locked_chats"
                            android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_locked_chats_desc"
                            android:textAppearance="@style/TextAppearance.Chatly.Register.Muted" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_prof_chevron"
                        app:tint="@color/register_icon_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hộp peace of mind -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">


                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_priv_shield_check"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_note_title"
                        android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_note_body"
                        android:textAppearance="@style/TextAppearance.Chatly.Register.Footer" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>