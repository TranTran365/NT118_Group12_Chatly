<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAddFriend"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.contacts.AddFriendActivity">

    <!-- Header xanh -->
    <LinearLayout
        android:id="@+id/layoutAddFriendHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAddFriendTagline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_extrabold"
                android:letterSpacing="0.05"
                android:text="@string/add_friend_tagline"
                android:textColor="@color/on_background_muted"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_chatly_logo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAddFriendBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/register_back"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_reg_back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvAddFriendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add_friend_title"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Headline" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tờ trắng bo góc -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_chats_sheet"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutAddFriendContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvAddFriendIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/add_friend_intro"
                android:textColor="@color/surface_deep"
                android:textSize="14sp" />

            <!-- Hai tab email / phone -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAddFriendTabEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_active"
                    android:fontFamily="@font/nunito_bold"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/add_friend_tab_email"
                    android:textColor="@color/surface_deep"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAddFriendTabPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/add_friend_tab_phone"
                    android:textColor="@color/surface_deep"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nhãn + ô nhập -->
            <TextView
                android:id="@+id/tvAddFriendFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/add_friend_label_email"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Muted"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddFriend"
                style="@style/Widget.Chatly.Register.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_reg_mail"
                app:startIconTint="@color/surface_deep">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddFriend"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:hint="@string/add_friend_hint_email"
                    android:imeOptions="actionSearch"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    tools:text="an.vo@email.com" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvAddFriendHelper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:text="@string/add_friend_helper_email"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Muted"
                android:textSize="12sp" />

            <!-- Khối kết quả (trạng thái "tìm thấy") -->
            <LinearLayout
                android:id="@+id/layoutAddFriendResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAddFriendMatchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_friend_match_one"
                    android:textAppearance="@style/TextAppearance.Chatly.Register.Muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAddFriendAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_add_friend_avatar"
                        android:fontFamily="@font/nunito_extrabold"
                        android:gravity="center"
                        android:text="@string/add_friend_sample_initials"
                        android:textColor="@color/background"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAddFriendName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="@string/add_friend_sample_name"
                            android:textColor="@color/surface_deep"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tvAddFriendResultEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/add_friend_sample_email"
                            android:textAppearance="@style/TextAppearance.Chatly.Register.Muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAddFriendFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/add_friend_found"
                    android:textColor="@color/surface_deep"
                    android:textSize="14sp" />

                <!-- Nút add friend: cùng kiểu nút "add a friend" ở Contacts -->
                <LinearLayout
                    android:id="@+id/btnAddFriendSend"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_contacts_add_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="@string/add_friend_send"
                        android:textColor="@color/surface_deep"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/surface_deep" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>