<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/register_sheet"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.profile.EditProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header xanh -->
        <LinearLayout
            android:id="@+id/header_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/register_header_padding_bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/register_back"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_reg_back"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/register_logo_description"
                    android:src="@drawable/ic_chatly_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/edit_title"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/edit_subtitle"
                android:textAppearance="@style/TextAppearance.Chatly.Register.Subtitle" />
        </LinearLayout>

        <!-- Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- Avatar + Change photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="@dimen/edit_avatar_size"
                        android:layout_height="@dimen/edit_avatar_size"
                        android:layout_marginEnd="@dimen/edit_badge_overhang">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_edit_avatar"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Chatly.Circle" />

                        <TextView
                            android:id="@+id/tv_initials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Chatly.Profile.Initials"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            tools:text="AM" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_change_photo"
                        android:layout_width="@dimen/edit_badge_size"
                        android:layout_height="@dimen/edit_badge_size"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_edit_badge"
                        android:clickable="true"
                        android:contentDescription="@string/edit_change_photo"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_prof_camera"
                            app:tint="@color/on_accent" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_change_photo_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_change_photo"
                        android:textAppearance="@style/TextAppearance.Chatly.EditProfile.Link" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/edit_change_photo_hint"
                        android:textAppearance="@style/TextAppearance.Chatly.Register.Muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Full name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_field_to_label"
                android:text="@string/edit_label_full_name"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_full_name"
                style="@style/Widget.Chatly.Register.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_label_to_field"
                app:startIconDrawable="@drawable/ic_reg_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_full_name"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    tools:text="Alex Morgan" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bio + bộ đếm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_field_to_label"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/edit_label_bio"
                    android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

                <TextView
                    android:id="@+id/tv_bio_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Chatly.Register.Muted"
                    tools:text="28/120" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bio"
                style="@style/Widget.Chatly.Register.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_label_to_field"
                app:startIconDrawable="@drawable/ic_edit_bio">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bio"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:maxLines="1"
                    tools:text="Here for good conversations." />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email (chỉ đọc) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_field_to_label"
                android:text="@string/edit_label_email"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.Chatly.EditProfile.TextInput.ReadOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_label_to_field"
                android:enabled="false"
                app:startIconDrawable="@drawable/ic_reg_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:enabled="false"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/register_icon_muted"
                    tools:text="alex.morgan@gmail.com" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_field_to_label"
                android:text="@string/edit_label_phone"
                android:textAppearance="@style/TextAppearance.Chatly.Register.FieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/Widget.Chatly.Register.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/register_label_to_field"
                app:startIconDrawable="@drawable/ic_prof_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_phone"
                    style="@style/Widget.Chatly.Register.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:autofillHints="phone"
                    android:inputType="phone"
                    android:maxLines="1"
                    tools:text="+1 (415) 555-0128" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Chatly.Register.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/register_button_height"
                android:layout_marginTop="24dp"
                android:gravity="start|center_vertical"
                android:text="@string/edit_save"
                android:textAlignment="viewStart"
                app:icon="@drawable/ic_reg_arrow_forward"
                app:iconGravity="end"
                app:iconSize="20dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>