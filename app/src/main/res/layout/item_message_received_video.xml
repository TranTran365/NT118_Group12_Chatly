<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="48dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/ll_bubble"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_msg_media_received"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivVideoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chatly.MediaCorner"
                tools:src="@drawable/bg_media_placeholder" />

            <ImageView
                android:id="@+id/ivPlayButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="Play Video"
                android:src="@drawable/ic_play_yellow" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/bevietnampro_regular"
            android:textColor="@color/surface_deep"
            android:textSize="13sp"
            tools:text="café tour · 0:24 · 8.2 MB" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            tools:text="9:32" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-6dp"
        android:background="@drawable/bg_date_badge"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/surface_deep"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
