<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <ImageView
        android:id="@+id/btnMinimize"
        android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_chevron_down"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:text="CHATLY VIDEO"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="@id/btnMinimize"
        app:layout_constraintBottom_toBottomOf="@id/btnMinimize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_call_more"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Khung preview: Multimedia Lead sẽ nhét camera/video vào đây -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="#EEF1FA"
        app:layout_constraintTop_toBottomOf="@id/btnMinimize"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvCallingChip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_call_badge"
            android:paddingHorizontal="12dp" android:paddingVertical="5dp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="@color/surface_deep"
            android:textSize="11sp"
            tools:text="calling Minh Anh..."/>

        <TextView
            android:id="@+id/tvBottomChip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_call_badge"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp"
            android:fontFamily="@font/nunito_bold"
            android:text="you"
            android:textColor="@color/surface_deep"
            android:textSize="11sp"/>

        <FrameLayout
            android:id="@+id/pipContainer"
            android:layout_width="88dp" android:layout_height="124dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_call_pip"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_call_badge"
                android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                android:fontFamily="@font/nunito_bold"
                android:text="you"
                android:textColor="@color/surface_deep"
                android:textSize="10sp"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom panel -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="@color/surface_deep"
        android:orientation="vertical"
        android:paddingTop="20dp" android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- mute / flip / camera off -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/btnMute"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_call_action"
                    android:padding="12dp"
                    android:src="@drawable/ic_call_mute"
                    app:tint="@color/call_action_tint"
                    android:contentDescription="Mute"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="mute"
                    android:textColor="@color/white" android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/btnFlip"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_call_action"
                    android:padding="12dp"
                    android:src="@drawable/ic_call_flip"
                    app:tint="@color/call_action_tint"
                    android:contentDescription="Flip camera"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="flip"
                    android:textColor="@color/white" android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/btnCameraOff"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_call_action"
                    android:padding="12dp"
                    android:src="@drawable/ic_call_camera_off"
                    app:tint="@color/call_action_tint"
                    android:contentDescription="Camera off"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="camera off"
                    android:textColor="@color/white" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Cancel call: icon + chữ nằm giữa nút -->
        <LinearLayout
            android:id="@+id/btnCancel"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
            android:background="@drawable/bg_call_pill_yellow"
            android:clickable="true" android:focusable="true"
            android:gravity="center" android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_call_decline"
                app:tint="@color/surface_deep"/>

            <TextView
                android:id="@+id/tvCancelLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/nunito_extrabold"
                android:includeFontPadding="false"
                android:text="cancel call"
                android:textColor="@color/surface_deep"
                android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>