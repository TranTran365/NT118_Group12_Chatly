<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="48dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/ll_bubble"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_msg_media_received"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="File Document"
                android:src="@drawable/ic_attach_file"
                app:tint="@color/surface_deep" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="@font/bevietnampro_bold"
                    android:maxLines="1"
                    android:textColor="@color/surface_deep"
                    android:textSize="13sp"
                    tools:text="weekend_plan.pdf" />

                <TextView
                    android:id="@+id/tvSubDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    tools:text="PDF · 2.4 MB" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivDownloadButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Download File"
                android:src="@drawable/ic_download_received"
                app:tint="@color/surface_deep" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            tools:text="9:33" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-6dp"
        android:background="@drawable/bg_date_badge"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/surface_deep"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
