<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header xanh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_extrabold"
                android:letterSpacing="0.05"
                android:text="@string/contacts_tagline"
                android:textColor="@color/on_background_muted"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_chatly_logo" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito_extrabold"
            android:text="@string/contacts_title"
            android:textColor="@color/white"
            android:textSize="32sp" />
    </LinearLayout>

    <!-- Tờ trắng bo góc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_chats_sheet"
        android:orientation="vertical">

        <!-- Ô tìm kiếm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/surface_deep" />

            <EditText
                android:id="@+id/etContactsSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:fontFamily="@font/nunito_bold"
                android:hint="@string/contacts_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/surface_deep"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Tab lọc: all / online / requests -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="6dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvContactsFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_active"
                android:fontFamily="@font/nunito_bold"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="@string/contacts_filter_all"
                android:textColor="@color/surface_deep"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvContactsFilterOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/nunito_bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/contacts_filter_online"
                android:textColor="@color/surface_deep"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvContactsFilterRequests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/contacts_filter_requests"
                    android:textColor="@color/surface_deep"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvContactsRequestsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chats_badge"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:textColor="@color/surface_deep"
                    android:textSize="11sp"
                    tools:text="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vùng cuộn: thẻ requests + (Bước 3) online now + danh sách -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Thẻ "people said hey" -->
                    <LinearLayout
                        android:id="@+id/layoutRequestsBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/bg_contacts_request_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/contacts_cd_add_friend"
                            android:src="@drawable/ic_contacts_add_friend"
                            app:tint="@color/surface_deep" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRequestsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/surface_deep"
                                android:textSize="15sp"
                                tools:text="3 people said hey" />

                            <TextView
                                android:id="@+id/tvRequestsSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:textColor="@color/contacts_text_muted"
                                android:textSize="12sp"
                                tools:text="Mai, Bảo and Hân · take a peek" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/surface_deep" />
                    </LinearLayout>

                    <!-- Bước 3: hàng "online now" và danh sách theo chữ cái sẽ thêm ở đây -->
                    <!-- Hàng "online now" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:text="@string/contacts_online_now"
                                android:textColor="@color/surface_deep"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvContactsOnlineCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:textColor="@color/contacts_text_muted"
                                android:textSize="11sp"
                                tools:text="2 around" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvContactsOnline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_contact_online" />
                    </LinearLayout>

                    <!-- Danh sách theo chữ cái -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvContacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_contact_row" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Bước 4: cột chữ cái A-Z sẽ thêm ở đây -->
            <!-- Cột chữ cái A-Z -->
            <TextView
                android:id="@+id/tvAlphabetIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/contacts_cd_alphabet_index"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.8"
                android:minWidth="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/contacts_alphabet_index"
                android:textColor="@color/contacts_alphabet_idle"
                android:textSize="7sp" />
        </FrameLayout>

        <!-- Nút add a friend -->
        <LinearLayout
            android:id="@+id/btnAddFriend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_contacts_add_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_extrabold"
                android:text="@string/contacts_add_friend"
                android:textColor="@color/surface_deep"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/surface_deep" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>